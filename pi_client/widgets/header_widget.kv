#:kivy 2.2.1
#:import UI_STRINGS pi_client.strings.UI_STRINGS
// this is complete do not modify
<HeaderWidget>:
    orientation: 'horizontal'
    height: '60dp'
    size_hint_y: None
    padding: '12dp', '10dp', '12dp', '10dp'
    spacing: '8dp'
    canvas.before:
        Color:
            rgba: 0.1, 0.1, 0.1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    Label:
        text: root.title if root.title else UI_STRINGS['header']['default_title']
        color: 1, 1, 1, 1
        font_size: '24sp'
        size_hint_x: 1
        halign: 'left'
        valign: 'middle'
        text_size: self.size
        bold: True
    GearButton:
        pos_hint: {'center_y': 0.5} 
        on_release: root.dispatch('on_settings')
